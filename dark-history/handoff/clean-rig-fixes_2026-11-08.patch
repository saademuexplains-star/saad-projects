+    g += `<path d="M${x0},${y0 + (y1 - y0) * 0.62} L${x0 + w * 0.3},${y0 + (y1 - y0) * 0.55} L${x1},${y0 + (y1 - y0) * 0.58} L${x1},${y1} L${x0},${y1}Z" fill="#0e0f11"/>`;
