+    rims: [{ from: [1, -0.1], col: '#ffb060', w: 6, op: 0.5 }, { from: [-0.8, -0.6], col: '#b0b2b0', w: 4, op: 0.12 }], face: { col: '#ffd0a0', op: 0.2 } };
